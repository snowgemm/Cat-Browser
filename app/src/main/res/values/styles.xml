<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CatBrowser" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101318</item>
        <item name="android:navigationBarColor">#101318</item>
        <item name="android:windowBackground">#101318</item>
    </style>

    <style name="Theme.CatBrowser.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#101318</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.CatBrowser</item>
    </style>
</resources>
